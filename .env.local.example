NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=EBENEZER
NEXT_PUBLIC_APP_URL=http://localhost:4001
NEXT_PUBLIC_DEFAULT_EVENT_ID=
# ID de l'événement Jeûne des Jeunes (obtenu via `npm run seed:events` dans backend/)
NEXT_PUBLIC_JDJ_EVENT_ID=NEXT_PUBLIC_JDJ_EVENT_ID
# IDs du Séminaire des Pasteurs et du Camp de Nuit (affichés par `npm run seed:events` dans backend/)
NEXT_PUBLIC_SEMINAIRE_EVENT_ID=
NEXT_PUBLIC_CAMP_EVENT_ID=
# ID de la Conférence des Professionnels (affiché par `npm run seed:events` dans backend/)
NEXT_PUBLIC_CONFERENCE_EVENT_ID=
# Liens Google Forms utilisés pour l'inscription au séminaire et à la conférence
NEXT_PUBLIC_SEMINAIRE_GOOGLE_FORM_URL=
NEXT_PUBLIC_CONFERENCE_GOOGLE_FORM_URL=
